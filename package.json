{
  "name": "shecandns",
  "version": "1.0.0",
  "description": "با «شکن» تحریم‌های اینترنتی رو بی‌اثر کن!",
  "keywords": [
    "shecandns-win",
    "dns",
    "shecandns",
    "win"
  ],
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md-akhi/ShecanDNS-Win.git"
  },
  "author": "Mohammad Amanalikhani <md.akhi.ir@gmail.com> (http://md.akhi.ir)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/md-akhi/ShecanDNS-Win/issues"
  },
  "homepage": "https://github.com/md-akhi/ShecanDNS-Win#readme",
  "build": {
    "appId": "com.example.shecandns",
    "productName": "Shecan DNS",
    "copyright": "Copyright © 2025",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "requireAdministrator"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true
    }
  },
  "dependencies": {
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.0",
    "sudo-prompt": "^9.2.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "jest": "^29.7.0",
    "spectron": "^19.0.0",
    "vite": "^6.3.1"
  }
}
